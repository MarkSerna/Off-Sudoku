# Copy this file to keystore.properties (ignored by git) to sign release builds,
# or run .\scripts\build-play-release.ps1 to generate everything interactively.
# Never commit real passwords or .jks/.keystore files to source control.
storeFile=altikore-sudoku-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=altikore-sudoku
keyPassword=CHANGE_ME_KEY_PASSWORD
